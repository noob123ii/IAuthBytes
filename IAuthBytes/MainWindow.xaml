<Window x:Class="IAuthBytes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="IAuthBytes - Made by Notlucy" Height="700" Width="1040"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Border Background="#090B10" CornerRadius="10" BorderThickness="1" BorderBrush="#181C26">
        <wv2:WebView2 x:Name="Browser"/>
    </Border>
</Window>